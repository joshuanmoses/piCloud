# ---- Secrets -------------------------------------------------------------
# .env holds the database password and the application secret key.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
secrets/

# ---- Build output --------------------------------------------------------
bin/
frontend/dist/
frontend/coverage/
backend/coverage.out
backend/coverage.html

# The embedded SPA is generated by `make build-frontend`. Only the committed
# placeholder index.html is tracked, so `go build` works in a clean checkout.
backend/internal/web/dist/*
!backend/internal/web/dist/index.html

# ---- Dependencies --------------------------------------------------------
node_modules/
frontend/.vite/

# ---- Local runtime data --------------------------------------------------
.dev-data/
deploy/caddy/data/
deploy/caddy/config/
*.db
*.sqlite

# ---- Editors and operating systems ---------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- Test output ---------------------------------------------------------
# Written by the CI test step so a later step can check what was skipped.
backend/test-output.txt

# ---- Backups -------------------------------------------------------------
*.sql.gz
*.dump
backups/
